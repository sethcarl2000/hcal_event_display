# ------------------------------------------------------------------------------------
# 
#   To use the EventDisplay software with your root macros, you need this script 
#   to point ROOT to the EventDisplay code library. To do this, run the following command (in bash): 
#   
#       source build/set_edisp_env.sh    
#
#   this script is generated by cmake, don't edit it unless you know what you're doing. 
#
_path_include="@EDISP_ENV_INCLUDE_PATH@"
_path_lib="@EDISP_ENV_BUILD_PATH@"

path_is_in_list() {
    local path="${1}"
    local list="${2}"

    IFS=":" read -ra paths <<< "${list}"

    for path_item in "${paths[@]}" 
    do
        # return '0' if the path is found in the list. 
        if [[ "${path_item}" == "${path}" ]]; then return 0; fi 
    done   

    # return '1' if not found
    return 1; 
}

# if a path is missing from a colon (:) delimited list of paths, then prepend it to the front of the list. 
prepend_path_to_list() {
    local my_path="${1}"
    local LIST_NAME="${2}"
    local list="${!LIST_NAME}"

    if path_is_in_list "${my_path}" "${list}"; 
    then
        echo "${list}"
    else    
        echo "${my_path}${!LIST_NAME:+:${!LIST_NAME}}"
    fi
}

export ROOT_INCLUDE_PATH=$(prepend_path_to_list "${_path_include}" "ROOT_INCLUDE_PATH")

export LD_LIBRARY_PATH=$(prepend_path_to_list "${_path_lib}" "LD_LIBRARY_PATH")

unset _path_include
unset _path_lib 

# check if each path is in the list. 
